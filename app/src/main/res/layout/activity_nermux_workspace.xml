<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nermux_terminal_background"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="54dp"
        android:layout_height="match_parent"
        android:background="@drawable/nermux_activity_rail_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageButton
            android:id="@+id/workspace_close_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_close_workspace"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@color/nermux_text_secondary" />

        <ImageButton
            android:id="@+id/workspace_terminal_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/nermux_primary_icon_button_background"
            android:contentDescription="@string/action_terminal_here"
            android:padding="11dp"
            android:src="@drawable/ic_terminal"
            app:tint="@color/nermux_text_primary" />

        <ImageButton
            android:id="@+id/workspace_pick_folder_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_choose_folder"
            android:padding="11dp"
            android:src="@drawable/ic_folder_open"
            app:tint="@color/nermux_text_secondary" />

        <ImageButton
            android:id="@+id/workspace_new_file_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_new_file"
            android:padding="11dp"
            android:src="@drawable/ic_file"
            app:tint="@color/nermux_accent_bright" />

        <ImageButton
            android:id="@+id/workspace_new_folder_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_new_folder"
            android:padding="11dp"
            android:src="@drawable/ic_folder"
            app:tint="@color/nermux_accent_bright" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/workspace_up_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_go_up"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_upward"
            app:tint="@color/nermux_text_secondary" />

        <ImageButton
            android:id="@+id/workspace_home_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_home"
            android:padding="12dp"
            android:src="@drawable/ic_home"
            app:tint="@color/nermux_text_secondary" />

        <ImageButton
            android:id="@+id/workspace_refresh_button"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_refresh"
            android:padding="12dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/nermux_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/nermux_terminal_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/nermux_workspace_header_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="EXPLORER"
                    android:textColor="@color/nermux_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/workspace_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="start"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/nermux_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/workspace_item_count"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/nermux_count_pill_background"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="42dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/nermux_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/workspace_file_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:cacheColorHint="@android:color/transparent"
                android:clipToPadding="false"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:listSelector="@android:color/transparent"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/workspace_editor_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/nermux_terminal_background"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/nermux_workspace_header_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageButton
                        android:id="@+id/workspace_editor_close_button"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_close_editor"
                        android:padding="9dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/nermux_text_secondary" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/nermux_selection_rail" />

                    <View
                        android:id="@+id/workspace_editor_dirty_indicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/nermux_dirty_dot_background"
                        android:visibility="gone" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/workspace_editor_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/nermux_editor_tab_background"
                        android:ellipsize="middle"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:minHeight="30dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:singleLine="true"
                        android:textColor="@color/nermux_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/workspace_find_button"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_find"
                        android:padding="9dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/nermux_text_secondary" />

                    <ImageButton
                        android:id="@+id/workspace_save_button"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/nermux_primary_icon_button_background"
                        android:contentDescription="@string/action_save_file"
                        android:padding="9dp"
                        android:src="@drawable/ic_save"
                        app:tint="@color/nermux_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/nermux_editor_background"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/workspace_line_numbers"
                        android:layout_width="46dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/nermux_editor_gutter_background"
                        android:gravity="top|end"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/nermux_text_muted"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/workspace_editor"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:gravity="top|start"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textNoSuggestions"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp"
                        android:scrollbars="vertical"
                        android:textColor="@color/nermux_text_primary"
                        android:textColorHighlight="@color/nermux_surface_pressed"
                        android:textCursorDrawable="@null"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/workspace_editor_status"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:background="@color/nermux_accent"
                    android:gravity="center_vertical|end"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/nermux_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
