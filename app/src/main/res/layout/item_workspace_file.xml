<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingTop="1dp"
    android:paddingEnd="0dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:id="@+id/workspace_file_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/nermux_file_row_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/workspace_file_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:padding="5dp"
            app:tint="@color/nermux_accent_bright" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/workspace_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/nermux_text_primary"
                android:textSize="13sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/workspace_file_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/nermux_text_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/workspace_file_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/nermux_compact_button_background"
            android:contentDescription="@string/action_file_actions"
            android:focusable="false"
            android:padding="9dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/nermux_text_secondary" />
    </LinearLayout>
</FrameLayout>
