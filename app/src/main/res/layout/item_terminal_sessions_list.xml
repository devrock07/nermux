<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/session_row"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/session_background_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/session_index"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/nermux_session_badge_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/nermux_accent_bright"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/nermux_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/nermux_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/close_session_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/nermux_close_button_background"
            android:contentDescription="@string/action_close_session"
            android:focusable="false"
            android:padding="11dp"
            android:src="@drawable/ic_close"
            app:tint="@color/nermux_text_secondary" />
    </LinearLayout>
</FrameLayout>
