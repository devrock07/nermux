<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingTop="3dp"
    android:paddingEnd="0dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/session_row"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@drawable/session_background_selected"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="10dp">

        <View
            android:id="@+id/session_selection_rail"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@drawable/nermux_selection_rail" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/session_index"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/nermux_session_badge_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/nermux_accent_bright"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/nermux_text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/session_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/nermux_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/session_status"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nermux_count_pill_background"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="42dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/nermux_accent_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/close_session_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/nermux_close_button_background"
            android:contentDescription="@string/action_close_session"
            android:focusable="false"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/nermux_text_secondary" />
    </LinearLayout>
</FrameLayout>
