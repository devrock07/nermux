<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/nermux_terminal_background">

                <ImageView
                    android:id="@+id/terminal_wallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.72"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/nermux_terminal_wallpaper" />

                <com.termux.view.TerminalView
                    android:id="@+id/terminal_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusableInTouchMode="true"
                    android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                    android:scrollbars="vertical"
                    tools:ignore="UnusedAttribute" />

                <FrameLayout
                    android:id="@+id/nermux_boot_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/nermux_boot_overlay_background"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/nermux_boot_panel"
                        android:layout_width="252dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:background="@drawable/nermux_boot_panel_background"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="16dp">

                        <ImageView
                            android:id="@+id/nermux_boot_wordmark"
                            android:layout_width="196dp"
                            android:layout_height="44dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/nermux_wordmark" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/nermux_boot_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/nermux_boot_status"
                            android:textColor="@color/nermux_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="13dp"
                            android:background="@drawable/nermux_boot_progress_track">

                            <View
                                android:id="@+id/nermux_boot_progress"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/nermux_boot_progress_fill" />
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="304dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="horizontal"
                android:background="?attr/termuxActivityDrawerBackground">

                <LinearLayout
                    android:layout_width="54dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/nermux_activity_rail_background"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <ImageButton
                        android:id="@+id/power_center_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/nermux_primary_icon_button_background"
                        android:contentDescription="@string/action_open_power_center"
                        android:padding="11dp"
                        android:src="@drawable/ic_power_tools"
                        app:tint="@color/nermux_text_primary" />

                    <ImageButton
                        android:id="@+id/workspace_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_open_workspace"
                        android:padding="11dp"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/nermux_text_secondary" />

                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_open_settings"
                        android:padding="11dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/nermux_text_secondary" />

                    <ImageButton
                        android:id="@+id/agent_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_open_ai_agent"
                        android:padding="10dp"
                        android:src="@drawable/ic_agent"
                        app:tint="@color/nermux_accent_bright" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/toggle_keyboard_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_toggle_soft_keyboard"
                        android:padding="11dp"
                        android:src="@drawable/ic_keyboard"
                        app:tint="@color/nermux_text_secondary" />

                    <ImageButton
                        android:id="@+id/new_session_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/nermux_primary_icon_button_background"
                        android:contentDescription="@string/action_new_session"
                        android:padding="11dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/nermux_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/nermux_surface_deep"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="EXPLORER"
                            android:textColor="@color/nermux_text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/application_name"
                            android:textColor="@color/nermux_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/nermux_outline" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="@string/title_terminal_sessions"
                        android:textColor="@color/nermux_text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ListView
                        android:id="@+id/terminal_sessions_list"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_gravity="top"
                        android:layout_weight="1"
                        android:choiceMode="singleChoice"
                        android:clipToPadding="false"
                        android:divider="@android:color/transparent"
                        android:dividerHeight="0dp"
                        android:listSelector="@android:color/transparent"
                        android:longClickable="true"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/agent_drawer"
                android:layout_width="328dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@drawable/nermux_agent_drawer_background"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/nermux_primary_icon_button_background"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_agent"
                        app:tint="@color/nermux_text_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/title_ai_agent"
                            android:textColor="@color/nermux_text_primary"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/agent_header_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/nermux_ai_waiting"
                            android:textColor="@color/nermux_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/agent_clear_button"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_ai_clear_chat"
                        android:padding="10dp"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/nermux_text_secondary" />

                    <ImageButton
                        android:id="@+id/close_agent_button"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/nermux_compact_button_background"
                        android:contentDescription="@string/action_close_ai_agent"
                        android:padding="10dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/nermux_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nermux_outline" />

                <ScrollView
                    android:id="@+id/agent_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/nermux_ai_panel_intro"
                            android:textColor="@color/nermux_text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/agent_provider_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/nermux_agent_status_pill_background"
                            android:includeFontPadding="false"
                            android:textColor="@color/nermux_accent_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/agent_workspace_card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/nermux_agent_card_background"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/nermux_ai_workspace_label"
                                android:textColor="@color/nermux_accent_bright"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/agent_workspace_path"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:ellipsize="middle"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:text="@string/nermux_ai_workspace_missing"
                                android:textColor="@color/nermux_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/agent_workspace_meta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:includeFontPadding="false"
                                android:text="@string/nermux_ai_workspace_missing"
                                android:textColor="@color/nermux_text_muted"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:layout_marginTop="11dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/agent_choose_workspace_button"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    android:background="@drawable/nermux_agent_primary_button_background"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/action_ai_choose_workspace"
                                    android:textColor="@color/nermux_text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/agent_shell_workspace_button"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/nermux_agent_secondary_button_background"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/action_ai_use_shell_folder"
                                    android:textColor="@color/nermux_text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/agent_open_workspace_button"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/nermux_agent_secondary_button_background"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/action_ai_open_workspace"
                                    android:textColor="@color/nermux_text_primary"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <EditText
                            android:id="@+id/agent_prompt_input"
                            android:layout_width="match_parent"
                            android:layout_height="96dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/nermux_agent_input_background"
                            android:gravity="top|start"
                            android:hint="@string/hint_ai_prompt"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="5"
                            android:overScrollMode="never"
                            android:paddingStart="12dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="11dp"
                            android:textColor="@color/nermux_text_primary"
                            android:textColorHint="@color/nermux_text_muted"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/agent_fix_button"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/nermux_agent_secondary_button_background"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/action_ai_fix_error"
                                android:textColor="@color/nermux_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/agent_explain_button"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/nermux_agent_secondary_button_background"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/action_ai_explain"
                                android:textColor="@color/nermux_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <ImageButton
                                android:id="@+id/agent_send_button"
                                android:layout_width="46dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/nermux_agent_primary_button_background"
                                android:contentDescription="@string/action_ai_send"
                                android:padding="11dp"
                                android:src="@drawable/ic_send"
                                app:tint="@color/nermux_text_primary" />
                        </LinearLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:includeFontPadding="false"
                            android:text="@string/nermux_ai_chat_label"
                            android:textColor="@color/nermux_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/agent_status_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:includeFontPadding="false"
                            android:text="@string/nermux_ai_waiting"
                            android:textColor="@color/nermux_accent_bright"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:id="@+id/agent_chat_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:includeFontPadding="false"
                            android:text="@string/nermux_ai_tools_label"
                            android:textColor="@color/nermux_text_muted"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/nermux_agent_card_background"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/nermux_ai_context_label"
                                android:textColor="@color/nermux_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:includeFontPadding="false"
                                android:text="@string/nermux_ai_context_ready"
                                android:textColor="@color/nermux_text_muted"
                                android:textSize="11sp" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/nermux_outline" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/nermux_ai_command_guard_label"
                                android:textColor="@color/nermux_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:includeFontPadding="false"
                                android:text="@string/nermux_ai_command_guard_ready"
                                android:textColor="@color/nermux_text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/nermux_outline" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/agent_settings_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@color/nermux_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/action_ai_settings"
                    android:textColor="@color/nermux_accent_bright"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/nermux_toolbar_background"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
