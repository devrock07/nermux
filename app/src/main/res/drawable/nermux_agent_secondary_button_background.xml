<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/nermux_surface_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/nermux_accent_bright" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/nermux_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/nermux_outline" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
