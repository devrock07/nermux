<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nermux_accent_pressed">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#7A0F1D31"
                android:endColor="#6A132945" />
            <stroke
                android:width="1dp"
                android:color="@color/nermux_outline_soft" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
