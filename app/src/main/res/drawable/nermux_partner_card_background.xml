<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nermux_accent_pressed">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#E10B1424"
                android:centerColor="#D6112543"
                android:endColor="#C9061224" />
            <stroke
                android:width="1dp"
                android:color="@color/nermux_power_hairline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
