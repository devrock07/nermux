<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/nermux_accent_pressed">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/nermux_glass_high"
                android:centerColor="@color/nermux_power_glass_mid"
                android:endColor="@color/nermux_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/nermux_power_hairline" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</ripple>
