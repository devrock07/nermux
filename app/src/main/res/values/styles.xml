<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="TermuxAlertDialogStyle" parent="@style/Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/nermux_accent_bright</item>
        <item name="colorAccent">@color/nermux_accent_bright</item>
        <item name="colorSurface">@color/nermux_surface</item>
        <item name="colorOnSurface">@color/nermux_text_primary</item>
    </style>

    <style name="NermuxAlertDialogTheme" parent="@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorAccent">@color/nermux_accent_bright</item>
        <item name="colorSurface">@color/nermux_surface</item>
        <item name="colorOnSurface">@color/nermux_text_primary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/NermuxDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/NermuxDialogBody</item>
        <item name="buttonBarButtonStyle">@style/NermuxDialogButton</item>
    </style>

    <style name="NermuxDialogTitle" parent="@style/TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/nermux_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NermuxDialogBody" parent="@style/TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/nermux_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="NermuxDialogButton" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/nermux_accent_bright</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Light" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/nermux_text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="TermuxActivity.Drawer.ButtonBarStyle.Dark" parent="@style/Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/nermux_text_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="TextAppearance.Widget.BaseToolbar.Title" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">@color/nermux_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Widget.BaseToolbar.Subtitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Subtitle">
        <item name="android:textColor">@color/nermux_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="NermuxPreferenceTheme">
        <item name="preferenceStyle">@style/NermuxPreference</item>
        <item name="preferenceCategoryStyle">@style/NermuxPreferenceCategory</item>
        <item name="preferenceScreenStyle">@style/NermuxPreference</item>
        <item name="dialogPreferenceStyle">@style/NermuxPreference</item>
        <item name="switchPreferenceCompatStyle">@style/NermuxSwitchPreference</item>
    </style>

    <style name="NermuxPreference">
        <item name="layout">@layout/nermux_preference_item</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="NermuxSwitchPreference" parent="@style/NermuxPreference">
        <item name="widgetLayout">@layout/preference_widget_switch_compat</item>
    </style>

    <style name="NermuxPreferenceCategory">
        <item name="layout">@layout/nermux_preference_category</item>
        <item name="iconSpaceReserved">false</item>
    </style>

</resources>
