<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxApp Light DarkActionBar theme. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar">
        <item name="colorPrimary">@color/nermux_surface_high</item>
        <item name="colorPrimaryVariant">@color/nermux_terminal_background</item>
        <item name="colorPrimaryDark">@color/nermux_surface</item>
        <item name="colorSecondary">@color/nermux_accent</item>
        <item name="colorSecondaryVariant">@color/nermux_accent_bright</item>
        <item name="colorOnPrimary">@color/nermux_text_primary</item>
        <item name="colorOnSecondary">@color/nermux_text_primary</item>
        <item name="colorSurface">@color/nermux_surface</item>
        <item name="colorOnSurface">@color/nermux_text_primary</item>
        <item name="android:windowBackground">@color/nermux_terminal_background</item>
        <item name="android:statusBarColor">@color/nermux_terminal_background</item>
        <item name="android:navigationBarColor">@color/nermux_terminal_background</item>
        <item name="android:textColorPrimary">@color/nermux_text_primary</item>
        <item name="android:textColorSecondary">@color/nermux_text_secondary</item>
        <item name="android:textColorLink">@color/nermux_accent_bright</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="alertDialogTheme">@style/NermuxAlertDialogTheme</item>
        <item name="preferenceTheme">@style/NermuxPreferenceTheme</item>
    </style>
    <!-- TermuxApp Light NoActionBar theme. -->
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.TermuxApp.Light.DarkActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.TermuxApp.Light.DarkActionBar"/>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.TermuxApp.Light.NoActionBar"/>


    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/nermux_surface</item>
        <item name="colorPrimaryVariant">@color/nermux_terminal_background</item>
        <item name="colorSecondary">@color/nermux_accent</item>
        <item name="colorOnSecondary">@color/nermux_text_primary</item>

        <item name="android:windowBackground">@color/nermux_terminal_background</item>
        <item name="android:navigationBarColor">@color/nermux_terminal_background</item>
        <item name="android:statusBarColor">@color/nermux_terminal_background</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Light</item>
        <item name="termuxActivityDrawerBackground">@drawable/nermux_drawer_background</item>
        <item name="termuxActivityDrawerImageTint">@color/nermux_text_primary</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/nermux_text_primary</item>
        <item name="extraKeysButtonActiveTextColor">@color/nermux_accent_bright</item>
        <item name="extraKeysButtonBackgroundColor">@color/nermux_extra_key_surface</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/nermux_extra_key_surface_active</item>
    </style>

</resources>
